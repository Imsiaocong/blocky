{
  "name": "temp-blocky",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test:local": "node --experimental-strip-types --test server/local-api.test.ts",
    "runner": "node --env-file=.env.runner.local --experimental-strip-types server/gpu-runner.ts",
    "runner:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-gpu.ps1",
    "runner:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-gpu.ps1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.151.0",
    "ws": "^8.22.0"
  }
}
